# Never commit a populated .env file. SanctionBench reads credentials only
# from the process environment.
COURTLISTENER_API_TOKEN=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# Authenticated DeepSeek runs accept only this official HTTPS origin.
DEEPSEEK_BASE_URL=https://api.deepseek.com
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Campaign model IDs are explicit spend decisions. Set currently available,
# provider-documented IDs before running configs/campaign.example.yaml.
SANCTIONBENCH_OPENAI_MODEL=
SANCTIONBENCH_DEEPSEEK_MODEL=
SANCTIONBENCH_ANTHROPIC_MODEL=
SANCTIONBENCH_GOOGLE_MODEL=

# Only these exact field-specific variables may point outside the checkout.
SANCTIONBENCH_ORGANIC_DOCUMENT_DATASET=
SANCTIONBENCH_PRIVATE_CITATION_DATASET=
SANCTIONBENCH_PRIVATE_DOCUMENT_DATASET=
SANCTIONBENCH_PRIVATE_RESULTS_DIR=
